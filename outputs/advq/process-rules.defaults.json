    {
      "id": "pdf-rollpack",
      "no": 10,
      "title": "小卷/包净重 · 小卷/包毛重",
      "description": "面巾/卫卷/纸巾/餐巾/湿巾范围：两项不得为空、须为数字、小卷/包净重 < 小卷/包毛重（矛盾计阻断）；除湿巾、餐巾外 小卷/包净重(g) × 装数 = 不含赠品净重，2% 容差（不符计一致性待核）。",
      "enabled": true,
      "scope": {
        "logic": "OR",
        "conditions": [
          {
            "field": "$ruleCat",
            "op": "in",
