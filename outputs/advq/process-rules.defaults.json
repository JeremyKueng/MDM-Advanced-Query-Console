                  },
                  {
                    "field": "米数",
                    "op": "lte",
                    "value": 0
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pdf-paper",
      "no": 7,
      "title": "纸长 / 纸宽",
      "description": "面巾类、纸巾、餐巾、湿巾、口罩、生活用垫纸（非卷类、非组合）：纸长、纸宽不得为空。常规软抽/面巾（库存类别 成品.面巾.软抽*、成品.面巾.面巾*）纸宽不得为 105/120/133/153/160/187/189——这些是典型纸长值，出现即长宽互换嫌疑，计阻断。",
      "enabled": true,
      "scope": {
        "logic": "AND",
        "conditions": [
          {
            "field": "品类三级",
