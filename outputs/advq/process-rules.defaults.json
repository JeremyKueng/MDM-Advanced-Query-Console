          }
        }
      ]
    },
    {
      "id": "pdf-rollname",
      "no": 6,
      "title": "节数 / 米数 / 净含量 / 毛重每卷",
      "description": "卫卷标准品：名称含“毛重：N克”时毛重/卷须 >0；名称含“克”时净含量须 >0；名称含“节数/米数”时对应字段须 >0（字段均已设必填，不再校验非空）。",
      "enabled": true,
      "scope": {
        "logic": "AND",
        "conditions": [
          {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料库存类别",
                "op": "contains",
                "value": "卫卷"
              },
              {
                "field": "物料库存类别",
                "op": "notContains",
                "value": "方块"
              }
            ]
          },
          {
            "logic": "OR",
            "conditions": [
              {
                "field": "标准/迷你",
                "op": "empty"
              },
              {
                "field": "标准/迷你",
                "op": "prefix",
                "value": "标准"
              }
            ]
          }
        ]
      },
      "checks": [
        {
          "id": "c1",
          "enabled": true,
          "message": "毛重/卷",
          "code": "PFM",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "grossName"
              },
              {
                "field": "毛重/卷",
                "op": "empty"
              }
            ]
          }
        },
        {
          "id": "c2",
          "enabled": true,
          "message": "毛重/卷",
          "code": "PFN",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "grossName"
              },
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "毛重/卷",
                    "op": "junk"
                  },
                  {
                    "field": "毛重/卷",
                    "op": "lte",
                    "value": 0
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c3",
          "enabled": true,
          "message": "净含量",
          "code": "PFM",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "contains",
                "value": "克"
              },
              {
                "field": "净含量",
                "op": "empty"
              }
            ]
          }
        },
        {
          "id": "c4",
          "enabled": true,
          "message": "净含量",
          "code": "PFN",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "contains",
                "value": "克"
              },
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "净含量",
                    "op": "junk"
                  },
                  {
                    "field": "净含量",
                    "op": "lte",
                    "value": 0
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c5",
          "enabled": true,
          "message": "节数",
          "code": "PFM",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "contains",
                "value": "节数"
              },
              {
                "field": "节数",
                "op": "empty"
              }
            ]
          }
        },
        {
          "id": "c6",
          "enabled": true,
          "message": "节数",
          "code": "PFN",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "contains",
                "value": "节数"
              },
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "节数",
                    "op": "junk"
                  },
                  {
                    "field": "节数",
                    "op": "lte",
                    "value": 0
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c7",
          "enabled": true,
          "message": "米数",
          "code": "PFM",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "contains",
                "value": "米数"
              },
              {
                "field": "米数",
                "op": "empty"
              }
            ]
          }
        },
        {
          "id": "c8",
          "enabled": true,
          "message": "米数",
          "code": "PFN",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "物料说明",
                "op": "contains",
                "value": "米数"
              },
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "米数",
