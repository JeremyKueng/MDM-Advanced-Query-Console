                        "field": "品类三级",
                        "op": "contains",
                        "value": "湿巾"
                      },
                      {
                        "field": "物料库存类别",
                        "op": "contains",
                        "value": "湿纸巾"
                      }
                    ]
                  }
                ]
              },
              {
                "field": "品类三级",
                "op": "neq",
                "value": "餐巾"
              },
              {
                "field": "原始装数",
                "op": "nonzero"
              },
              {
                "op": "difference",
                "left": "[小卷/包净重(g)] * [原始装数]",
                "right": "[不含赠品净重] * 1000",
                "absolute": 1,
                "relative": 0.02
              }
            ]
          }
        }
