            "op": "empty"
          }
        },
        {
          "id": "c4",
          "enabled": true,
          "message": "小卷/包毛重",
          "code": "PFN",
          "when": {
            "field": "小卷/包毛重(g)",
            "op": "junk"
          }
        },
        {
          "id": "c5",
          "enabled": true,
          "message": "小卷/包净重≥小卷/包毛重",
          "code": "PFC",
          "when": {
            "field": "小卷/包净重(g)",
            "op": "gte",
            "otherField": "小卷/包毛重(g)",
            "epsilon": 1e-09
          }
        },
        {
          "id": "c6",
          "enabled": true,
          "message": "小卷/包净重×装数≠不含赠品净重",
          "code": "PFP",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "logic": "NOT",
                "conditions": [
                  {
                    "logic": "OR",
                    "conditions": [
