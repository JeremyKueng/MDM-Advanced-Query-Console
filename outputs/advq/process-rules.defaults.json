                    "value": "卫卷"
                  },
                  {
                    "field": "物料库存类别",
                    "op": "notContains",
                    "value": "方块"
                  }
                ]
              }
            ]
          },
          {
            "logic": "NOT",
            "conditions": [
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "物料库存类别",
                    "op": "contains",
                    "value": "组合"
                  },
                  {
                    "field": "是否组合装",
                    "op": "eq",
                    "value": "是"
                  }
                ]
              }
            ]
          }
