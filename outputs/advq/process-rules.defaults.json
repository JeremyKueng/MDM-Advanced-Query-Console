      },
      "checks": [
        {
          "id": "c1",
          "enabled": true,
          "message": "纸长",
          "code": "PFM",
          "when": {
            "field": "纸长",
            "op": "empty"
          }
        },
        {
          "id": "c2",
          "enabled": true,
          "message": "纸长",
          "code": "PFN",
          "when": {
            "field": "纸长",
            "op": "junk"
          }
        },
        {
          "id": "c3",
          "enabled": true,
          "message": "纸宽",
          "code": "PFM",
          "when": {
            "field": "纸宽",
            "op": "empty"
          }
        },
        {
          "id": "c4",
          "enabled": true,
          "message": "纸宽",
          "code": "PFN",
          "when": {
            "field": "纸宽",
            "op": "junk"
          }
        },
        {
