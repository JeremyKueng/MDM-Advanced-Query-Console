{
  "version": 1,
  "scope": {
    "logic": "AND",
    "conditions": [
      {
        "field": "物料状态",
        "op": "eq",
        "value": "有效"
      },
      {
        "field": "成品类型",
        "op": "notContains",
        "value": "进口"
      },
      {
        "field": "物料编码",
        "op": "notPrefix",
        "value": "1900"
      }
    ]
  },
  "rules": [
    {
      "id": "pdf-ecom",
      "no": 1,
      "title": "电商一致性",
      "description": "是否电商=是 的产品须至少维护一个条码（基准条码/外包装条码/小包条码/手抽中袋条码），保证电商上架信息完整。",
      "enabled": true,
      "scope": {
        "logic": "AND",
        "conditions": [
          {
            "field": "是否电商",
            "op": "eq",
            "value": "是"
          }
        ]
      },
      "checks": [
        {
          "id": "c1",
          "enabled": true,
          "message": "条码缺失",
          "code": "PFI",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "field": "基准条码",
                "op": "empty"
              },
              {
                "field": "外包装条形码（选择组织）",
                "op": "empty"
              },
              {
                "field": "小包/袋/盒产品条码",
                "op": "empty"
              },
              {
                "field": "手抽/中袋条形码",
                "op": "empty"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pdf-weight",
      "no": 2,
      "title": "净重 / 不含赠品净重 / 毛重",
      "description": "三项均不得为空；不含赠品净重 ≤ 净重；净重 < 毛重。为空计必填缺失（提示），比较矛盾与非数字计阻断。",
      "enabled": true,
      "scope": {
        "logic": "AND",
        "conditions": []
      },
      "checks": [
        {
          "id": "c1",
          "enabled": true,
          "message": "净重",
          "code": "PFM",
          "when": {
            "field": "净重",
            "op": "empty"
          }
        },
        {
          "id": "c2",
          "enabled": true,
          "message": "净重",
          "code": "PFN",
          "when": {
            "field": "净重",
            "op": "junk"
          }
        },
        {
          "id": "c3",
          "enabled": true,
          "message": "不含赠品净重",
          "code": "PFM",
          "when": {
            "field": "不含赠品净重",
            "op": "empty"
          }
        },
        {
          "id": "c4",
          "enabled": true,
          "message": "不含赠品净重",
          "code": "PFN",
          "when": {
            "field": "不含赠品净重",
            "op": "junk"
          }
        },
        {
          "id": "c5",
          "enabled": true,
          "message": "毛重",
          "code": "PFM",
          "when": {
            "field": "毛重",
            "op": "empty"
          }
        },
        {
          "id": "c6",
          "enabled": true,
          "message": "毛重",
          "code": "PFN",
          "when": {
            "field": "毛重",
            "op": "junk"
          }
        },
        {
          "id": "c7",
          "enabled": true,
          "message": "不含赠品净重>净重",
          "code": "PFC",
          "when": {
            "field": "不含赠品净重",
            "op": "gt",
            "otherField": "净重",
            "epsilon": 1e-09
          }
        },
        {
          "id": "c8",
          "enabled": true,
          "message": "净重≥毛重",
          "code": "PFC",
          "when": {
            "field": "净重",
            "op": "gte",
            "otherField": "毛重",
            "epsilon": 1e-09
          }
        },
        {
          "id": "c9",
          "enabled": true,
          "message": "不含赠品净重≤0",
          "code": "PFC",
          "when": {
            "field": "不含赠品净重",
            "op": "lte",
            "value": 0
          }
        },
        {
          "id": "c10",
          "enabled": true,
          "message": "毛重≤0",
          "code": "PFC",
          "when": {
            "field": "毛重",
            "op": "lte",
            "value": 0
          }
        }
      ]
    },
    {
      "id": "pdf-quant",
      "no": 3,
      "title": "成品定量",
      "description": "排除制造类别=其他；其余不得为空、不得为非数字、不得 ≤0。",
      "enabled": true,
      "scope": {
        "logic": "AND",
        "conditions": [
          {
            "field": "制造类别",
            "op": "neq",
            "value": "其他"
          }
        ]
      },
      "checks": [
        {
          "id": "c1",
          "enabled": true,
          "message": "成品定量",
          "code": "PFM",
          "when": {
            "field": "成品定量",
            "op": "empty"
          }
        },
        {
          "id": "c2",
          "enabled": true,
          "message": "成品定量",
          "code": "PFN",
          "when": {
            "logic": "OR",
            "conditions": [
              {
                "field": "成品定量",
                "op": "junk"
              },
              {
                "field": "成品定量",
                "op": "lte",
                "value": 0
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pdf-wetnet",
      "no": 4,
      "title": "不含液成品净重",
      "description": "湿巾（品类三级含湿巾或库存类别为成品.湿纸巾）不得为空且须为数字；不含液成品净重 < 净重(含液)、< 不含赠品净重；湿巾组合装不适用。非湿巾按规范应为空，但 MDM 尚未屏蔽其他品类填写（排期优化中），仅提示不阻断。",
      "enabled": true,
      "scope": {
        "logic": "AND",
        "conditions": []
      },
      "checks": [
        {
          "id": "c1",
          "enabled": true,
          "message": "不含液成品净重",
          "code": "PFM",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "品类三级",
                    "op": "contains",
                    "value": "湿巾"
                  },
                  {
                    "field": "物料库存类别",
                    "op": "contains",
                    "value": "湿纸巾"
                  }
                ]
              },
              {
                "logic": "NOT",
                "conditions": [
                  {
                    "logic": "OR",
                    "conditions": [
                      {
                        "field": "物料库存类别",
                        "op": "contains",
                        "value": "组合"
                      },
                      {
                        "field": "是否组合装",
                        "op": "eq",
                        "value": "是"
                      }
                    ]
                  }
                ]
              },
              {
                "field": "不含液成品净重（kg）",
                "op": "empty"
              }
            ]
          }
        },
        {
          "id": "c2",
          "enabled": true,
          "message": "不含液成品净重",
          "code": "PFN",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "品类三级",
                    "op": "contains",
                    "value": "湿巾"
                  },
                  {
                    "field": "物料库存类别",
                    "op": "contains",
                    "value": "湿纸巾"
                  }
                ]
              },
              {
                "logic": "NOT",
                "conditions": [
                  {
                    "logic": "OR",
                    "conditions": [
                      {
                        "field": "物料库存类别",
                        "op": "contains",
                        "value": "组合"
                      },
                      {
                        "field": "是否组合装",
                        "op": "eq",
                        "value": "是"
                      }
                    ]
                  }
                ]
              },
              {
                "field": "不含液成品净重（kg）",
                "op": "junk"
              }
            ]
          }
        },
        {
          "id": "c3",
          "enabled": true,
          "message": "不含液成品净重≤0",
          "code": "PFC",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "品类三级",
                    "op": "contains",
                    "value": "湿巾"
                  },
                  {
                    "field": "物料库存类别",
                    "op": "contains",
                    "value": "湿纸巾"
                  }
                ]
              },
              {
                "logic": "NOT",
                "conditions": [
                  {
                    "logic": "OR",
                    "conditions": [
                      {
                        "field": "物料库存类别",
                        "op": "contains",
                        "value": "组合"
                      },
                      {
                        "field": "是否组合装",
                        "op": "eq",
                        "value": "是"
                      }
                    ]
                  }
                ]
              },
              {
                "field": "不含液成品净重（kg）",
                "op": "lte",
                "value": 0
              }
            ]
          }
        },
        {
          "id": "c4",
          "enabled": true,
          "message": "不含液成品净重≥净重",
          "code": "PFC",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "品类三级",
                    "op": "contains",
                    "value": "湿巾"
                  },
                  {
                    "field": "物料库存类别",
                    "op": "contains",
                    "value": "湿纸巾"
                  }
                ]
              },
              {
                "logic": "NOT",
                "conditions": [
                  {
                    "logic": "OR",
                    "conditions": [
                      {
                        "field": "物料库存类别",
                        "op": "contains",
                        "value": "组合"
                      },
                      {
                        "field": "是否组合装",
                        "op": "eq",
                        "value": "是"
                      }
                    ]
                  }
                ]
              },
              {
                "field": "不含液成品净重（kg）",
                "op": "gte",
                "otherField": "净重",
                "epsilon": 1e-09
              }
            ]
          }
        },
        {
          "id": "c5",
          "enabled": true,
          "message": "不含液成品净重≥不含赠品净重",
          "code": "PFC",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "logic": "OR",
                "conditions": [
                  {
                    "field": "品类三级",
                    "op": "contains",
                    "value": "湿巾"
                  },
                  {
                    "field": "物料库存类别",
                    "op": "contains",
                    "value": "湿纸巾"
                  }
                ]
              },
              {
                "logic": "NOT",
                "conditions": [
                  {
                    "logic": "OR",
                    "conditions": [
                      {
                        "field": "物料库存类别",
                        "op": "contains",
                        "value": "组合"
                      },
                      {
                        "field": "是否组合装",
                        "op": "eq",
                        "value": "是"
                      }
                    ]
                  }
                ]
              },
              {
                "field": "不含液成品净重（kg）",
                "op": "gte",
                "otherField": "不含赠品净重",
                "epsilon": 1e-09
              }
            ]
          }
        },
        {
          "id": "c6",
          "enabled": true,
          "message": "非湿巾已填不含液净重",
          "code": "PFI",
          "when": {
            "logic": "AND",
            "conditions": [
              {
                "logic": "NOT",
                "conditions": [
                  {
                    "logic": "OR",
                    "conditions": [
                      {
                        "field": "品类三级",
                        "op": "contains",
                        "value": "湿巾"
                      },
                      {
                        "field": "物料库存类别",
                        "op": "contains",
                        "value": "湿纸巾"
                      }
                    ]
                  }
                ]
              },
              {
                "field": "不含液成品净重（kg）",
                "op": "notEmpty"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pdf-rollgeom",
      "no": 5,
      "title": "节距 / 卷高",
      "description": "库存类别含卫卷且非方块：节距、卷高不得为空；“无要求/无节距”视为已确认；非数字计阻断。",
