                "op": "contains",
                "value": "湿纸巾"
              }
            ]
          }
        ]
      },
      "checks": [
        {
          "id": "c1",
          "enabled": true,
          "message": "小卷/包净重",
          "code": "PFM",
          "when": {
            "field": "小卷/包净重(g)",
            "op": "empty"
          }
        },
        {
          "id": "c2",
          "enabled": true,
          "message": "小卷/包净重",
          "code": "PFN",
          "when": {
            "field": "小卷/包净重(g)",
            "op": "junk"
          }
        },
        {
          "id": "c3",
          "enabled": true,
          "message": "小卷/包毛重",
